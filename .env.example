# ── База данных ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://watcher:watcher@localhost:5432/watcher

# ── Веб-сервер ───────────────────────────────────────────────────────────────
PORT=3000
# Публичный адрес приложения. Нужен для ссылки привязки Telegram и вебхука.
PUBLIC_URL=http://localhost:3000
# Секрет для подписи сессионных кук. Сгенерировать: openssl rand -hex 32
SESSION_SECRET=change-me-openssl-rand-hex-32
# Разрешена ли регистрация новых пользователей
ALLOW_REGISTRATION=true

# ── Wildberries ──────────────────────────────────────────────────────────────
# Регион доставки: влияет на цену и наличие. -1257786 = Москва.
WB_DEST=-1257786
# Скидка постоянного покупателя, которую подставляем в запрос карточки.
WB_SPP=30
# HTTP-прокси для запросов к WB (нужен, если сервер вне РФ). Пример: http://user:pass@1.2.3.4:8080
WB_PROXY=
# Привязка к конкретному сетевому интерфейсу/адресу (опционально).
WB_INTERFACE=

# ── Планировщик ──────────────────────────────────────────────────────────────
# Включить фоновый обход цен (в разработке можно выключить).
SCHEDULER_ENABLED=true
# Интервал проверки цен по умолчанию, минут.
DEFAULT_CHECK_INTERVAL_MIN=60
# Как часто пересинхронизировать каталоги отслеживаемых продавцов, часов.
SELLER_SYNC_INTERVAL_HOURS=12

# ── Telegram ─────────────────────────────────────────────────────────────────
# Токен бота от @BotFather. Пусто = уведомления в Telegram выключены.
TELEGRAM_BOT_TOKEN=
# webhook (нужен публичный HTTPS) или polling (для локальной разработки)
TELEGRAM_MODE=polling
