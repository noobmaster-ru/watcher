{
  "name": "@watcher/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "node --watch --env-file-if-exists=../../.env --import tsx src/index.ts",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx src/db/migrate.ts",
    "test": "node --import tsx --test src/test/*.test.ts",
    "check:live": "node --import tsx src/test/live.ts",
    "user": "node --env-file-if-exists=../../.env --import tsx src/scripts/user.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@watcher/wb-core": "*",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.1",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "drizzle-kit": "^0.30.1"
  }
}
